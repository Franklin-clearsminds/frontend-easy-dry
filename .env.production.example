# =====================================================================
# PRODUCCIÓN - EasyDry Web (Angular + API)
# Copiar a `.env.production` o pegar en Render (build-time).
# =====================================================================

NG_APP_NAME=EasyDry®

# ---------------------------------------------------------------------
# 1. AMBIENTE DE TEST (DESARROLLO) — inactivo en este archivo
# ---------------------------------------------------------------------
# NG_APP_ENV=test
# NG_APP_PRODUCTION=false
# NG_APP_USE_MOCKS=true
# NG_APP_API_BASE_URL=https://www.testapi.easydry.com

# ---------------------------------------------------------------------
# 2. AMBIENTE DE PRODUCCIÓN
# ---------------------------------------------------------------------
NG_APP_ENV=production
NG_APP_PRODUCTION=true
# Cambiar a false para usar únicamente la API real.
NG_APP_USE_MOCKS=true
NG_APP_API_BASE_URL=https://www.api.easydry.com
