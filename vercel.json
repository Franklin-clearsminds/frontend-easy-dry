{
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" = \"develop\" ] && exit 1 || exit 0",
  "outputDirectory": "dist/frontend-easy-dry/browser",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
