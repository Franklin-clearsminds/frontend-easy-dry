# =====================================================================
# CONFIGURACIÓN DE AMBIENTE - EasyDry Web (Angular + AWS Cognito + API)
# =====================================================================
# Prefijo NG_APP_ (equivalente a VITE_ en un proyecto Vite).
# Solo valores públicos del cliente: User Pool ID, App Client ID, API.
# Nunca pongas client secret, AWS keys ni contraseñas.
#
# Uso:
#   npm start  -> lee este archivo (.env)          = TEST
#   npm run build -> lee .env.production           = PRODUCCIÓN
# En Render, define las mismas claves en Environment Variables.
# =====================================================================

NG_APP_NAME=EasyDry®

# ---------------------------------------------------------------------
# 1. AMBIENTE DE TEST (DESARROLLO)
# ---------------------------------------------------------------------
NG_APP_ENV=test
NG_APP_PRODUCTION=false
# true = prototipo local (login demo). false = Cognito + API AWS.
NG_APP_USE_MOCKS=true
NG_APP_COGNITO_REGION=us-east-2
NG_APP_COGNITO_USER_POOL_ID=us-east-2_TEST_POOL_ID
NG_APP_COGNITO_USER_POOL_CLIENT_ID=tu_test_client_id
NG_APP_API_BASE_URL=https://www.testapi.easydry.com

# ---------------------------------------------------------------------
# 2. AMBIENTE DE PRODUCCIÓN
# ---------------------------------------------------------------------
# NG_APP_ENV=production
# NG_APP_PRODUCTION=true
# NG_APP_USE_MOCKS=false
# NG_APP_COGNITO_REGION=us-east-2
# NG_APP_COGNITO_USER_POOL_ID=us-east-2_PROD_POOL_ID
# NG_APP_COGNITO_USER_POOL_CLIENT_ID=tu_prod_client_id
# NG_APP_API_BASE_URL=https://www.api.easydry.com
