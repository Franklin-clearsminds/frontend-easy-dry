# EasyDry Web — copia este archivo a .env y completa los valores.
# El archivo .env NO se sube a GitHub.

# API pública (sin secretos)
API_BASE_URL=https://dev-api.easydry.example/api/v1

# Cognito (IDs públicos de app client; NUNCA el client secret)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Ambiente: development | qa | production
APP_ENV=development
