# EasyDry Serverless — copia a serverless/.env
# Secretos reales van en AWS Secrets Manager, no aquí.

AWS_REGION=us-east-1
APP_ENV=development

# Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxx
COGNITO_CLIENT_ID_WEB=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_ID_MOBILE=xxxxxxxxxxxxxxxxxxxxxxxxxx

# DynamoDB (una tabla por contexto)
DDB_TABLE_IDENTITY=easydry-dev-identity
DDB_TABLE_OPERATIONS=easydry-dev-operations
DDB_TABLE_INVENTORY=easydry-dev-inventory
DDB_TABLE_MAINTENANCE=easydry-dev-maintenance
DDB_TABLE_REPORTING=easydry-dev-reporting
DDB_TABLE_AUDIT=easydry-dev-audit

# S3 evidencias (bucket privado)
S3_EVIDENCE_BUCKET=easydry-dev-evidence

# EventBridge
EVENT_BUS_NAME=easydry-dev

# Secrets Manager (nombres, no valores)
SECRETS_PREFIX=easydry/dev
